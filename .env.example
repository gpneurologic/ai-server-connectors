# Google OAuth Credentials
# Obtain from: https://console.developers.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here

# Token storage path (default: ~/.config/google-workspace-mcp/token.json)
# GOOGLE_TOKEN_PATH=~/.config/google-workspace-mcp/token.json

# OAuth redirect URI (default: http://localhost:8080/oauth2callback)
# GOOGLE_REDIRECT_URI=http://localhost:8080/oauth2callback

# Security settings
# Read-only mode (default: true)
MCP_READ_ONLY=true

# Require confirmation for write operations (default: true)
MCP_REQUIRE_CONFIRMATION=true

# Maximum results for list/search operations (default: 50)
# MCP_MAX_RESULTS=50

# Maximum email body characters to return (default: 10000)
# MCP_MAX_EMAIL_BODY_CHARS=10000

# Maximum file size for uploads (default: 10MB)
# MCP_MAX_FILE_SIZE_BYTES=10485760

# Logging level (default: INFO)
# MCP_LOG_LEVEL=INFO

# Service enablement (all default to true)
# MCP_ENABLE_GMAIL=true
# MCP_ENABLE_CALENDAR=true
# MCP_ENABLE_SHEETS=true
# MCP_ENABLE_SLIDES=true
# MCP_ENABLE_DRIVE=true
